# mimar-karari-temizle.ps1
# Amac: MIMAR_KARARI.md'yi temizle ve Faz 2 CLOSED olarak yeniden yaz

$ErrorActionPreference = "Stop"
$root = (Resolve-Path ".").Path

Write-Host "=== MIMAR_KARARI.md TEMIZLEME ===" -ForegroundColor Cyan
Write-Host ""

$hedefDosya = Join-Path $root "MIMAR_KARARI.md"

