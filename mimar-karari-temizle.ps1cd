# 2) Dosyayi yaz
$icerik = $satirlar -join "`n"
Set-Content -Path $hedefDosya -Value $icerik -Encoding UTF8
Write-Host "OK MIMAR_KARARI.md temizlendi" -ForegroundColor Green
Write-Host "   Satir sayisi: $($satirlar.Count)" -ForegroundColor Gray

# 3) Git
Write-Host "`n[GIT] Commit + push..." -ForegroundColor Yellow
cd $root
git add MIMAR_KARARI.md
git commit -m "docs: MIMAR_KARARI.md temizlendi - Faz 2 CLOSED"
git push

Write-Host ""
Write-Host "=== TAMAMLANDI ===" -ForegroundColor Green
Write-Host ""