export type LehceTipi = 'tumu' | 'doğu' | 'batı' | 'kabardey' | 'adige' | 'DOGU' | 'western';
export type AramaModuTipi = 'hepsi' | 'kelime' | 'anlam' | 'etimoloji';
export type AramaModu = AramaModuTipi;

export interface DictionaryItem {
  id: string;
  word: string;
  translation: string;
  dialect?: LehceTipi | string;
  dictionaryName?: string;
  file?: string;
  etimoloji?: string;
  kaynak?: string;
  [key: string]: any;
}

export type DictionaryRawItem = DictionaryItem;
export type DictionaryEntry = DictionaryItem;

export interface AktifSozlukItem {
  id: string;
  ad: string;
  aktif: boolean;
  kayitSayisi?: number;
  lehce?: string;
  yazar?: string;
  file?: string;
  [key: string]: any;
}

export interface ManifestData {
  toplamKelime: number;
  sozlukler: AktifSozlukItem[];
}

export interface TemaTipi {
  yaziAna: string;
  yaziAlt: string;
  kenarlik: string;
  kartArkaPlan: string;
  yaziIkincil?: string;
  [key: string]: any;
}

export interface HeaderProps {
  totalWords?: number;
  activeSourcesCount?: number;
}

export interface FooterProps {
  totalSources?: number;
  [key: string]: any;
}