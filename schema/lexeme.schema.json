{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cerkesce Lexeme Canonical Contract",
  "description": "Kanonik alan kurallari: pos (ve senkronize partOfSpeech), rootIds (ve senkronize rootId), translations, senses.",
  "type": "object",
  "required": ["id", "form", "meaning", "translations", "senses", "dialect", "conceptId"],
  "properties": {
    "id": { "type": "string", "minLength": 2 },
    "form": { "type": "string", "minLength": 1 },
    "pos": {
      "type": "string",
      "enum": ["noun", "verb", "adj", "adv", "phrase", "propn", "interj", "num", "part", "pron", "prefix", "adp", "symbol", "conj"]
    },
    "partOfSpeech": {
      "type": "string",
      "description": "Deprecated legacy mirror of pos; must equal pos until src/ migration completes."
    },
    "rootIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^R-" }
    },
    "rootId": {
      "type": "string",
      "description": "Deprecated legacy mirror of rootIds[0]; must equal rootIds[0] when rootIds is non-empty."
    },
    "wordFamilyId": { "type": "string", "pattern": "^WF-" },
    "dialect": { "type": "string", "enum": ["KBD", "ADY", "COMMON"] },
    "meaning": { "type": "string", "minLength": 1 },
    "translations": {
      "type": "object",
      "required": ["tr", "en", "ru"],
      "properties": {
        "tr": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "ru": { "type": "string", "minLength": 1 },
        "ar": { "type": "string" }
      }
    },
    "translationMeta": {
      "type": "object",
      "description": "Ceviri durum ve provenance metaverisi (or. AI destekli Arapca onerileri icin).",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["missing", "ai-suggested", "human-verified"] },
          "model": { "type": ["string", "null"] },
          "suggestedAt": { "type": ["string", "null"] },
          "verifiedBy": { "type": ["string", "null"] }
        }
      }
    },
    "senses": { "type": "array", "minItems": 1 },
    "crossDialectEquivalents": {
      "type": "object",
      "description": "Farkli koklu lehcelerarasi esdeger kelimeler (simetrik KBD <-> ADY).",
      "properties": {
        "adyghe": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "kabardian": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  }
}
