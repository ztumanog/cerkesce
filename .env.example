# ============================================
# CERKesce Sozluk - Environment Variables
# ============================================
# Bu dosya sablonudur. Gercek degerler .env.local'da tutulur.
# .env.local ASLA git'e commit edilmez.

# --- Environment ---
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- API ---
API_BASE_URL=http://localhost:3000/api

# --- Secrets (ornek - gercek deger YOK) ---
# JWT_SECRET=<buraya-guclu-bir-secret>
# SENTRY_DSN=<buraya-sentry-dsn>
# WEBHOOK_SECRET=<buraya-webhook-secret>

# --- Error Tracking ---
# SENTRY_ENABLED=false
# SENTRY_DSN=

# --- Monitoring ---
# METRICS_ENABLED=true
# HEALTH_CHECK_ENABLED=true

# --- Secrets (Sprint 8.1.2) ---
# Bu degerler .env.local'da GERCEK degerlerle doldurulur.
# ASLA git'e commit edilmez.

# --- Auth (AUTH-001: Yonetici girisi) ---
# Oturum tokeni imza anahtari (uretim: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=<buraya-guclu-bir-secret>
# Yonetici e-postasi (giris sayfasinda kullanilir)
ADMIN_EMAIL=ornek@cerkesce.org
# Sifrenin SHA-256 hex'i (uretim: node -e "console.log(require('crypto').createHash('sha256').update('SIFRENIZ').digest('hex'))")
# Duz metin sifre ASLA yazilmaz
ADMIN_PASSWORD_HASH=<buraya-sifrenin-sha256-hexi>

CERKESCE_API_KEY_DEV=dev-api-key-change-me
CERKESCE_API_KEY_TEST=test-api-key-change-me
CERKESCE_API_KEY_PROD=

JWT_SECRET=change-me-to-32-char-min-secret-key-here
JWT_EXPIRES_IN=1h

WEBHOOK_SECRET=change-me-to-16-char-min-secret
