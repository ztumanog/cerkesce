# ============================================
# CERKesce Sozluk - Environment Variables
# ============================================
# Bu dosya sablonudur. Gercek degerler .env.local'da tutulur.
# .env.local ASLA git'e commit edilmez.

# --- Environment ---
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- API ---
API_BASE_URL=http://localhost:3000/api

# --- Secrets (ornek - gercek deger YOK) ---
# JWT_SECRET=<buraya-guclu-bir-secret>
# SENTRY_DSN=<buraya-sentry-dsn>
# WEBHOOK_SECRET=<buraya-webhook-secret>

# --- Error Tracking ---
# SENTRY_ENABLED=false
# SENTRY_DSN=

# --- Monitoring ---
# METRICS_ENABLED=true
# HEALTH_CHECK_ENABLED=true

# --- Secrets (Sprint 8.1.2) ---
# Bu degerler .env.local'da GERCEK degerlerle doldurulur.
# ASLA git'e commit edilmez.

CERKESCE_API_KEY_DEV=dev-api-key-change-me
CERKESCE_API_KEY_TEST=test-api-key-change-me
CERKESCE_API_KEY_PROD=

JWT_SECRET=change-me-to-32-char-min-secret-key-here
JWT_EXPIRES_IN=1h

WEBHOOK_SECRET=change-me-to-16-char-min-secret
